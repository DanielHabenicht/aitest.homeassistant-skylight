{
  "name": "Skylight Calendar",
  "version": "1.0.0",
  "slug": "skylight_calendar",
  "description": "A family calendar add-on for Home Assistant",
  "url": "https://github.com/DanielHabenicht/aitest.homeassistant-skylight",
  "arch": ["armhf", "armv7", "aarch64", "amd64", "i386"],
  "startup": "application",
  "boot": "auto",
  "init": false,
  "ports": {
    "8099/tcp": 8099
  },
  "webui": "http://[HOST]:8099",
  "ingress": true,
  "ingress_port": 8099,
  "panel_icon": "mdi:calendar-multiple",
  "panel_title": "Skylight Calendar"
}
